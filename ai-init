#!/usr/bin/env bash
# ai-init — Create the project's .ai/ agent directory, ready to use.
# .ai/agents.md is a symlink to the shared config (updates propagate to all
# projects); the rest are real project files. All gitignored, never committed.
# Project context (.ai/context/) and README.md are generated ON DEMAND by
# `ai-context` — never copied as generic templates.
set -euo pipefail

CONFIG="$HOME/.config/agent-config"
PROJECT="$(pwd)"

if [ ! -d "$CONFIG" ]; then
    echo "error: agent-config not found at $CONFIG. Run setup.sh first." >&2
    exit 1
fi

echo "=== ai-init: $(basename "$PROJECT") ==="

mkdir -p "$PROJECT/.ai"

# ── Shared base file: symlink (never copied, updates propagate) ──
if [ -e "$PROJECT/.ai/agents.md" ] && [ ! -L "$PROJECT/.ai/agents.md" ]; then
    echo "  skip: .ai/agents.md is a real file — move its content to .ai/project.md first"
else
    ln -sfn "$CONFIG/AGENTS.md" "$PROJECT/.ai/agents.md"
    echo "  linked: .ai/agents.md -> $CONFIG/AGENTS.md"
fi

# ── Project context files (real files, project-owned) ──
for f in project.md session.md assumptions.md scratchpad.md; do
    if [ ! -f "$PROJECT/.ai/$f" ]; then
        cp "$CONFIG/templates/$f" "$PROJECT/.ai/$f"
        echo "  created: .ai/$f"
    fi
done

# ── Project maturity (NEW = empty/scaffold; EXISTING = source/build/history) ──
MATURITY="NEW"
if git rev-parse --is-inside-work-tree >/dev/null 2>&1 \
   && [ "$(git rev-list --count HEAD 2>/dev/null || echo 0)" -gt 0 ]; then
    MATURITY="EXISTING"
elif [ -n "$(find . -maxdepth 3 -type f \( -name '*.kt' -o -name '*.java' -o -name '*.py' -o -name '*.go' \
       -o -name '*.rs' -o -name '*.ts' -o -name '*.js' \) ! -path './.git/*' 2>/dev/null | head -1)" ] \
  || [ -n "$(find . -maxdepth 2 \( -name 'build.gradle.kts' -o -name 'build.gradle' -o -name 'go.mod' \
       -o -name 'Cargo.toml' -o -name 'pyproject.toml' -o -name 'package.json' \) ! -path './.git/*' 2>/dev/null | head -1)" ]; then
    MATURITY="EXISTING"
fi
echo "  detected: $MATURITY project"

# ── Context entry (breadcrumb; topic docs + README are on demand via ai-context) ──
mkdir -p "$PROJECT/.ai/context"
if [ ! -f "$PROJECT/.ai/context/index.md" ]; then
    cat > "$PROJECT/.ai/context/index.md" <<EOF
# Project Context Index

Entry point for project context. Refreshed by \`ai-context\` on demand; topic
docs (domain, architecture, database, dependencies, conventions) and README.md
are generated by \`ai-context\` — run it once the project has real content.

## Snapshot
- Maturity: $MATURITY
- Stack: (not yet documented — run ai-context or fill this in)

## Pointers
- Rules: .ai/project.md — shared config: .ai/agents.md
- State: .ai/session.md — decisions: .ai/assumptions.md — notes: .ai/scratchpad.md
- Topic docs: .ai/context/ — committed docs: docs/

## Status
- Initialized by ai-init on $(date +%Y-%m-%d).
EOF
    echo "  created: .ai/context/index.md (entry — run 'ai-context' for topic docs + README)"
else
    echo "  skip: .ai/context/index.md exists"
fi

# ── gitignore: .ai/ stays out of the repo ──
GI="$PROJECT/.gitignore"
if [ -f "$GI" ]; then
    if grep -qxF ".ai/" "$GI"; then
        :
    else
        printf '%s\n' "" "# AI agent directory (per-project knowledge — never committed)" ".ai/" >> "$GI"
        echo "  .gitignore: added .ai/"
    fi
else
    printf '%s\n' "# AI agent directory (per-project knowledge — never committed)" ".ai/" > "$GI"
    echo "  .gitignore: created with .ai/ entry"
fi

echo ""
echo "Done. Project agent setup:"
echo "  .ai/agents.md      — symlink to shared config (updates propagate)"
echo "  .ai/project.md     — project rules (stack, build/test/lint, conventions)"
echo "  .ai/session.md     — current state"
echo "  .ai/assumptions.md — decision log"
echo "  .ai/scratchpad.md  — working notes"
echo "  .ai/context/       — project knowledge base (index.md created; topic docs on demand)"
echo "  README.md          — NOT auto-created. Generate on demand with real project"
echo "                       context: run 'ai-context' (or ask the agent after onboarding)"
echo "Structure: $CONFIG/docs/ai-directory.md"
